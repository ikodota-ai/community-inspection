<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.inspect.InsCourtyardMapper">

    <resultMap type="InsCourtyard" id="InsCourtyardResult">
        <id     property="courtyardId"   column="courtyard_id"/>
        <result property="courtyardName" column="courtyard_name"/>
        <result property="deptId"        column="dept_id"/>
        <result property="deptName"      column="dept_name"/>
        <result property="gridDeptId"    column="grid_dept_id"/>
        <result property="gridName"      column="grid_name"/>
        <result property="sortOrder"     column="sort_order"/>
        <result property="status"        column="status"/>
        <result property="createBy"      column="create_by"/>
        <result property="createTime"    column="create_time"/>
        <result property="updateBy"      column="update_by"/>
        <result property="updateTime"    column="update_time"/>
        <result property="remark"        column="remark"/>
    </resultMap>

    <sql id="selectCourtyardVo">
        select c.courtyard_id, c.courtyard_name, c.dept_id, d.dept_name,
               d.parent_id as grid_dept_id, gd.dept_name as grid_name,
               c.sort_order, c.status,
               c.create_by, c.create_time, c.update_by, c.update_time, c.remark
        from ins_courtyard c
        left join sys_dept d on c.dept_id = d.dept_id
        left join sys_dept gd on d.parent_id = gd.dept_id
    </sql>

    <select id="selectCourtyardList" parameterType="InsCourtyard" resultMap="InsCourtyardResult">
        <include refid="selectCourtyardVo"/>
        <where>
            <if test="courtyardName != null and courtyardName != ''">and c.courtyard_name like concat('%', #{courtyardName}, '%')</if>
            <if test="status != null and status != ''">and c.status = #{status}</if>
        </where>
        order by c.sort_order
    </select>

    <select id="selectCourtyardAll" resultMap="InsCourtyardResult">
        <include refid="selectCourtyardVo"/> where c.status = '0' order by c.sort_order
    </select>

    <select id="selectCourtyardById" parameterType="Long" resultMap="InsCourtyardResult">
        <include refid="selectCourtyardVo"/> where courtyard_id = #{courtyardId}
    </select>

    <insert id="insertCourtyard" parameterType="InsCourtyard" useGeneratedKeys="true" keyProperty="courtyardId">
        insert into ins_courtyard(courtyard_name, sort_order, status, create_by, create_time, remark)
        values(#{courtyardName}, #{sortOrder}, '0', #{createBy}, sysdate(), #{remark})
    </insert>

    <update id="updateCourtyard" parameterType="InsCourtyard">
        update ins_courtyard
        <set>
            <if test="courtyardName != null">courtyard_name = #{courtyardName},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="status != null">status = #{status},</if>
            update_by = #{updateBy}, update_time = sysdate()
        </set>
        where courtyard_id = #{courtyardId}
    </update>

    <delete id="deleteCourtyardById" parameterType="Long">
        delete from ins_courtyard where courtyard_id = #{courtyardId}
    </delete>

</mapper>
